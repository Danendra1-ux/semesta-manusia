# =============================================================================
# Environment variables — Semesta Manusia
# =============================================================================
# Salin file ini menjadi `.env` (untuk development lokal) atau isi nilainya
# di dashboard Vercel (Settings → Environment Variables) untuk production.
#
# JANGAN commit file `.env` ke git — file tersebut sudah di-ignore oleh
# `.gitignore`. Hanya `.env.example` yang boleh di-commit sebagai template.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# URL project Supabase Anda. Sumber: Supabase Dashboard → Project → Settings
# → API → Project URL. Aman di-expose ke client (prefix NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key. Aman di-expose ke client. Sumber sama seperti di atas
# (anon public key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — DIGUNAKAN DI SERVER ONLY untuk bypass RLS
# (mis. kirim email, hapus user). JANGAN pakai prefix NEXT_PUBLIC_.
# Sumber: Supabase Dashboard → Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Resend (email transactional)
# -----------------------------------------------------------------------------
# API key dari https://resend.com/api-keys
RESEND_API_KEY=

# Alamat pengirim email. Wajib pakai domain yang sudah diverifikasi di
# Resend Dashboard (https://resend.com/domains) supaya bisa kirim ke semua
# user. Saat development/testing boleh pakai:
#   Notifikasi Semesta Manusia <onboarding@resend.dev>
# Setelah deploy & punya domain, ganti ke:
#   Notifikasi Semesta Manusia <notif@domain-anda.com>
EMAIL_FROM=Semesta Manusia <noreply@semestamanusia.org>


# -----------------------------------------------------------------------------
# Site URL
# -----------------------------------------------------------------------------
# URL absolut website. Dipakai untuk link di email (login confirmation,
# remind-account, dll) dan untuk redirect Supabase Auth.
#
# - Development lokal:        http://localhost:3000
# - Setelah deploy Vercel:    https://semesta-manusia.vercel.app
# - Setelah ada domain custom: https://semestamanusia.id
NEXT_PUBLIC_SITE_URL=https://semestamanusia.org